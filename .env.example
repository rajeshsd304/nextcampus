# ---------------------------------------------------------------------------
# NextCampus environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ---------------------------------------------------------------------------

# Public URL of this deployment (used for auth redirects, emails, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key.
# Local: printed by `npx supabase start` / `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-or-anon-key

# Transactional email: "console" (logs emails, development) or "resend".
EMAIL_PROVIDER=console
EMAIL_FROM="NextCampus <no-reply@nextcampus.local>"
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Optional: where contact-form submissions are forwarded.
CONTACT_NOTIFICATION_EMAIL=

# Google OAuth for the LOCAL Supabase stack (read by supabase/config.toml).
# Hosted projects configure Google in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
